{
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "inlay_hints": {
        "enabled": true
      },
      "code_lens": "on"
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "inlay_hints": {
        "enabled": true
      },
      "code_lens": "on"
    }
  }
}
