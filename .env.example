# Создай .env рядом с этим файлом и подставь ключ DeepSeek.
DEEPSEEK_API_KEY=

# Необязательно: без значения используется deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash

# Учебный бюджет оценки входа; пустое значение отключает ограничение.
AGENT_MAX_INPUT_TOKENS=

# Периодическое сжатие; false запрещает новые сжатия.
AGENT_HISTORY_COMPRESSION=true

# Число сообщений (не пар): положительное чётное безопасное целое.
AGENT_KEEP_LAST_MESSAGES=10
